# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Environments and caches
.venv/
.cache/
.uv-cache/

# Raw and processed data are re-created by `python -m mapalign.fetch` (provenance in manifest.json)
data/raw/*
!data/raw/.gitkeep
!data/raw/manifest.json
# The exact inputs behind the published results are versioned (licences: data/raw/ATTRIBUTION.md)
!data/raw/57_D11_Mysore_1926.jpg
!data/raw/osm_57D11_overpass.json
!data/raw/osm_57D11_landmarks.json
!data/raw/ATTRIBUTION.md
data/processed/*
!data/processed/.gitkeep

# Large result rasters (metrics, CSVs and PNGs are committed)
results/*.tif
results/*.tiff
*.part

# Picking aids are regenerated with `python -m mapalign.gcp sheet/zoom`
gcp/picking/

# GPU-check figures duplicate the CPU ones; the JSON, run record and correspondences are committed
results/gpu/*.png

# Cloudflare Wrangler local state
.wrangler/

# LaTeX build by-products (the PDF itself is committed)
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz

# GDAL/QGIS statistics sidecars
*.aux.xml
